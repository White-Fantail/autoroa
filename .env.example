APP_ENV=development
DATABASE_URL=sqlite:///./carfolio.db
AUTH_MODE=development
DEV_AUTH_SECRET=local-only-secret
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=authenticated
OPENAI_API_KEY=
GOOGLE_MAPS_API_KEY=
OCR_PROVIDER=openai
MAPS_PROVIDER=google
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8081,http://127.0.0.1:8081
# Set both values only in staging when Carfolio Vercel preview deployments need API access.
CORS_VERCEL_PREVIEW_PROJECT=
CORS_VERCEL_PREVIEW_TEAM=
EXPO_PUBLIC_API_URL=http://localhost:8000/api/v1
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
